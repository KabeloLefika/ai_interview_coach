VITE_API_URL= http://127.0.0.1:8000

from pypdf import PdfReader
import boto3


def extract_text_with_pypdf(file_path: str) -> str:
    """Extract text from a normal text-based PDF."""

    reader = PdfReader(file_path)

    text = ""

    for page in reader.pages:
        page_text = page.extract_text()

        if page_text:
            text += page_text + "\n"

    return text.strip()


def extract_text_with_textract(file_path: str) -> str:
    """Extract text from a scanned/image-based PDF using AWS Textract."""

    textract = boto3.client(
        "textract",
        region_name="eu-central-1"
    )

    with open(file_path, "rb") as f:
        pdf_bytes = f.read()

    response = textract.detect_document_text(
        Document={
            "Bytes": pdf_bytes
        }
    )

    text = ""

    for block in response.get("Blocks", []):
        if block["BlockType"] == "LINE":
            text += block["Text"] + "\n"

    return text.strip()


def extract_text_from_pdf(file_path: str) -> str:
    """
    Try pypdf first.
    If little/no text is found, use AWS Textract.
    """

    text = extract_text_with_pypdf(file_path)

    # Normal PDF — pypdf successfully extracted text
    if len(text.strip()) >= 50:
        print("Using pypdf for CV text extraction.")
        return text

    # Scanned/image PDF — use Textract
    print("Little or no text found. Using AWS Textract...")

    text = extract_text_with_textract(file_path)

    return text