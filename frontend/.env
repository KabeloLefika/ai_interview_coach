VITE_API_URL= http://127.0.0.1:8000


from pypdf import PdfReader
import boto3


# AWS Textract client
textract = boto3.client("textract")


def extract_text_from_pdf(file_path: str) -> str:
    """
    Extract text from a PDF using pypdf.
    If the PDF is scanned/image-based and little or no text is found,
    fall back to Amazon Textract OCR.
    """

    reader = PdfReader(file_path)

    text = ""

    for page in reader.pages:
        page_text = page.extract_text()

        if page_text:
            text += page_text + "\n"

    # Clean the extracted text
    text = text.strip()

    # If enough text was extracted, use it
    if len(text) >= 50:
        return text

    # Otherwise, use Textract
    return extract_text_with_textract(file_path)


def extract_text_with_textract(file_path: str) -> str:
    """
    Use Amazon Textract to extract text from a scanned document.
    """

    with open(file_path, "rb") as document:
        document_bytes = document.read()

    response = textract.detect_document_text(
        Document={
            "Bytes": document_bytes
        }
    )

    text = ""

    for block in response.get("Blocks", []):
        if block["BlockType"] == "LINE":
            text += block["Text"] + "\n"

    return text.strip()